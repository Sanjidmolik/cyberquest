# Django / email / OAuth
# These are read by cyberquest/settings.py via python-dotenv.
# Put REAL values only in .env (gitignored). Leave secrets blank here.

# Local development: DEBUG=True and a non-production SECRET_KEY are fine.
# Production (e.g. Render): set DEBUG=False and a strong unique SECRET_KEY.
DEBUG=True
SECRET_KEY=

# Production database URL (for example Render PostgreSQL).
# Leave blank locally to use the default SQLite file db.sqlite3.
DATABASE_URL=

# Comma-separated hosts. Local defaults work without this.
# On Render, RENDER_EXTERNAL_HOSTNAME is added automatically — do not invent domains.
# ALLOWED_HOSTS=localhost,127.0.0.1
# Optional extra CSRF origins (comma-separated full origins, https://...)
# CSRF_TRUSTED_ORIGINS=

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL_ADDRESS=
# Seconds to wait for an SMTP connection. Leave blank to use 10.
# A blocked relay should fail this request, not hang the worker.
# EMAIL_TIMEOUT=10
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Question Bank (server-side only — never send to the browser)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash,gemini-flash-lite-latest
AI_GENERATION_TIMEOUT=180
AI_GENERATION_MAX_ATTEMPTS=2
AI_GENERATION_TEMPERATURE=0.4

# Public site origin for certificate QR codes (no trailing slash)
# Example: https://your-app.onrender.com
PUBLIC_BASE_URL=

# Directory for uploaded and generated media. Leave blank to use the project media/ folder.
# On a single-instance host, set this to the persistent disk mount after that disk exists.
MEDIA_ROOT=
