# Django / email / OAuth
# These are read by cyberquest/settings.py via python-dotenv.
# Put REAL values only in .env (gitignored). Leave these blank here.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL_ADDRESS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Question Bank (server-side only — never send to the browser)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash,gemini-flash-lite-latest
AI_GENERATION_TIMEOUT=180
AI_GENERATION_MAX_ATTEMPTS=2
AI_GENERATION_TEMPERATURE=0.4
