# Django / email / OAuth
# These are read by cyberquest/settings.py via python-dotenv.
# Put REAL values only in .env (gitignored). Leave secrets blank here.

# Local development: DEBUG=True and a non-production SECRET_KEY are fine.
# Production (e.g. Render): set DEBUG=False and a strong unique SECRET_KEY.
DEBUG=True
SECRET_KEY=

# Database URL. Production at launch: postgres://USER:PASSWORD@HOST:5432/DBNAME
# Local MySQL also works: mysql://USER:PASSWORD@HOST:3306/DBNAME
# Leave blank locally to use the default SQLite file db.sqlite3.
DATABASE_URL=

# Comma-separated hosts. Local defaults work without this.
# On Render, RENDER_EXTERNAL_HOSTNAME is added automatically — do not invent domains.
# ALLOWED_HOSTS=localhost,127.0.0.1
# Optional extra CSRF origins (comma-separated full origins, https://...)
# CSRF_TRUSTED_ORIGINS=

# Messaging: Fernet key(s) that encrypt stored message text. REQUIRED: the app won't start
# without one (system check messaging.E001). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK IT UP (password manager): if it's lost, stored messages can't be read.
# To rotate: put a new key first, keep the old ones after it (comma-separated), deploy, run
#   python manage.py rotate_message_keys
# then remove the old keys.
MESSAGE_ENCRYPTION_KEYS=

# Messaging live updates across several server processes (production only, optional):
# REDIS_URL=redis://...   (also install channels-redis). Without it, messages arrive by polling.
# Messaging limits per user (optional): MESSAGING_MESSAGES_PER_MINUTE=20, MESSAGING_NEW_CONVERSATIONS_PER_DAY=10
# Message reports per user per day (optional): MODERATION_REPORTS_PER_DAY=10

# Local SMTP. Leave blank when using the HTTPS API below.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Verified Brevo sender address. Used by SMTP and by the HTTPS API.
DEFAULT_FROM_EMAIL_ADDRESS=
# Render Free blocks outbound SMTP. Set this to send through Brevo's HTTPS API.
# Leave blank locally to keep SMTP.
BREVO_API_KEY=
# Seconds for the SMTP connection or the HTTPS API request. Leave blank to use 10.
# EMAIL_TIMEOUT=10
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Question Bank (server-side only — never send to the browser)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash,gemini-flash-lite-latest
AI_GENERATION_TIMEOUT=180
AI_GENERATION_MAX_ATTEMPTS=2
AI_GENERATION_TEMPERATURE=0.4

# Public site origin for certificate QR codes (no trailing slash)
# Example: https://your-app.onrender.com
PUBLIC_BASE_URL=

# Directory for uploaded and generated media. Leave blank to use the project media/ folder.
# On a single-instance host, set this to the persistent disk mount after that disk exists.
MEDIA_ROOT=

# Where uploaded and generated files are stored: "filesystem" (default, local
# development) or "r2" (a PRIVATE Cloudflare R2 bucket, for Render Free).
# With r2, the app refuses to start unless every value below is set.
MEDIA_STORAGE=filesystem
# R2 API token with Object Read & Write on this one bucket only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Either the account ID or the full S3 endpoint (https://<account-id>.r2.cloudflarestorage.com).
R2_ACCOUNT_ID=
# R2_ENDPOINT_URL=
# Optional: key prefix inside the bucket (default "media") and signed-URL lifetime in seconds.
# R2_MEDIA_PREFIX=media
# R2_SIGNED_URL_SECONDS=300

# Fernet key(s) that encrypt authenticator (TOTP) secrets at rest. Required in
# production; keep it out of the repository and the database, and back it up:
# losing it means users must re-enrol their authenticator app.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate: put the new key first (NEW,OLD), deploy, run manage.py rotate_field_encryption, drop OLD.
FIELD_ENCRYPTION_KEYS=

# Shown on the Privacy Policy, Terms, and Licenses pages. Leave blank to point
# people to the contact form.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
# Public repository of the running code (AGPL source offer for PyMuPDF).
# On Render the deployed commit is linked automatically from RENDER_GIT_COMMIT.
SOURCE_CODE_URL=

# Logging and Gunicorn (deploy/gunicorn.conf.py). Defaults are fine.
# LOG_LEVEL=INFO
# WEB_CONCURRENCY=2
# GUNICORN_TIMEOUT=60
